				<constellation type = "BEIDOU" frequency = "1544.21" polarisation="LHCP">
					<satellite id="632" priority = "10"/>
					<satellite id="633" priority = "10"/>
					<satellite id="640" priority = "10"/>
					<satellite id="643" priority = "25"/>
