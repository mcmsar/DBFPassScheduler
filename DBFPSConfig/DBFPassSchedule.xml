<ns2:config xmlns:ns2="urn:dbfconfig" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:dbfconfig file:///C://Users//joshua.rehm//TSiDBFPassScheduler//DBFPSConfig//dbfConfig.xsd" version="v1">
	<dbfpassschedule>
