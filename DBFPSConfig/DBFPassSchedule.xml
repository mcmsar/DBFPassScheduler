			</satellites>
		</dbfpassschedulecfg>
		<dbfplates>
			<dbfplate id = "1">
				<plateconfigfile>C:\\Users\\joshua.rehm\\TSiDBFPassScheduler\\DBFPSConfig\\DBFplate_01.xml</plateconfigfile>
				<plateminelevation> 12.0 </plateminelevation>
				<!-- Azimuth acceptance window, degrees north. 90..270 gives 90 degrees either
				     side of a plate face pointing due south. Omit both to disable azimuth
				     gating; min > max is read as a window wrapping through north. -->
				<plateminazimuth> 90.0 </plateminazimuth>
				<platemaxazimuth> 270.0 </platemaxazimuth>
				<!-- Thresholds a satellite must clear to actually be scheduled, as opposed to
				     plateminelevation above, which only decides what enters the pipeline.
				     satmin/satmaxelevation bound elevation above the local horizon, the upper
				     one being a site blockage limit. The plateminelevation* pair are floors on
				     the angle off the plate boresight, applied to LEO (satellite ids below 200)
				     and MEO (ids above 400) separately. All four are optional. -->
				<satminelevation> 12.0 </satminelevation>
				<satmaxelevation> 85.0 </satmaxelevation>
				<plateminelevationleo> 12.0 </plateminelevationleo>
				<plateminelevationmeo> 12.0 </plateminelevationmeo>
				<plateminseparationangle> 2.0 </plateminseparationangle>
				<location>
					<latitude>38.948341</latitude>
					<longitude>-76.830850</longitude>
					<altitude>0.071</altitude>
				</location>
				<combiners>
					<combiner id = "2">
						<!-- Primary,Fallback: tracks BEIDOU; if no BEIDOU satellite is in view at a
						     given time step, falls back to the fallback constellation named here.
						     Using LEO as the fallback for now since it already has real satellite
						     entries defined above; swap to GLONASS once its satellite ids/
						     frequency/polarisation are added under <satellites>. -->
						<constellation>BEIDOU,LEO</constellation>
						<ipaddress>\\127.0.0.1\C$\Users\joshua.rehm\TSiDBFPassScheduler\Output</ipaddress>
					</combiner>
					<combiner id = "1">
						<constellation>GALILEO</constellation>
						<ipaddress>\\127.0.0.1\C$\Users\joshua.rehm\TSiDBFPassScheduler\Output</ipaddress>
					</combiner>
				</combiners>
			</dbfplate>
		</dbfplates>
	</dbfpassschedule>
</ns2:config>
