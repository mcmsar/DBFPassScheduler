<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dbfconfig="urn:dbfconfig" targetNamespace="urn:dbfconfig" elementFormDefault="unqualified" >

 <!-- DBF pass schedule configuration -->

  <xs:element name="config" >
    <xs:complexType>
              <xs:sequence>
                <xs:element name="dbfpassschedule" type="dbfconfig:dbfpassschedule"  minOccurs="1" maxOccurs="1"/>
             </xs:sequence>
            <xs:attribute name="version" type="xs:string" use="required"/>
      </xs:complexType>
    </xs:element>

  <xs:complexType name="dbfpassschedule">
    <xs:all minOccurs="1">
      <xs:element name="dbfpassschedulecfg" type="dbfconfig:dbfpassschedulecfg"/>
      <xs:element name="dbfplates" type="dbfconfig:dbfplates"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType  name="dbfpassschedulecfg">
        <xs:all minOccurs="1">
            <xs:element name="meolutid" type="xs:integer"/>
            <xs:element type="dbfconfig:satellites" name="satellites"/>
        </xs:all>
  </xs:complexType>
  
  <xs:complexType name="satellites">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" type="dbfconfig:constellation" name="constellation"/>
        </xs:sequence>
  </xs:complexType>   
	
  <xs:complexType name="constellation">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" type="dbfconfig:satellite" name="satellite"/>
        </xs:sequence>
		<xs:attribute name="type" use="required" type="xs:string"/>
		<xs:attribute name="frequency" use="required" type="xs:decimal"/>
		<xs:attribute name="polarisation" use="required" type="xs:string"/>
  </xs:complexType> 	

   <xs:complexType name="satellite">
        <xs:attribute name="id" use="required" type="xs:string"/>
		<xs:attribute name="priority" use="required" type="xs:integer"/>
    </xs:complexType>

  <xs:complexType name="dbfplates">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" type="dbfconfig:dbfplate" name="dbfplate"/>
        </xs:sequence>
  </xs:complexType> 
 
  <xs:complexType name="dbfplate">
	<xs:all minOccurs="1">
		<xs:element name="plateconfigfile" type="xs:string"/>
		<xs:element name="plateminelevation" type="xs:decimal"/>
		<!-- Azimuth acceptance window at the plate, in degrees north. Optional: when
		     either limit is omitted the window spans the full circle, i.e. no azimuth
		     gating, which is how the scheduler behaved before these were added. A
		     window that wraps through north (min > max, e.g. 280..100) is honoured. -->
		<xs:element name="plateminazimuth" type="xs:decimal" minOccurs="0"/>
		<xs:element name="platemaxazimuth" type="xs:decimal" minOccurs="0"/>
		<!-- Elevation thresholds a satellite must clear to actually be scheduled, as
		     opposed to <plateminelevation> above, which only decides what enters the
		     pipeline. All optional; omitting one keeps the value that used to be
		     compiled into EMSDBFPassScheduler.cpp.
		     satminelevation/satmaxelevation bound the satellite's elevation above the
		     local horizon (the upper bound is a site blockage limit). The two
		     plateminelevation* values are floors on the angle off the plate boresight,
		     applied per constellation class: LEO for satellite ids below 200, MEO for
		     ids above 400.
		     satminelevationleo/satmaxelevationleo and satminelevationmeo/
		     satmaxelevationmeo override satminelevation/satmaxelevation for that
		     constellation class; any one omitted falls back to the shared value. -->
		<xs:element name="satminelevation" type="xs:decimal" minOccurs="0"/>
		<xs:element name="satmaxelevation" type="xs:decimal" minOccurs="0"/>
		<xs:element name="plateminelevationleo" type="xs:decimal" minOccurs="0"/>
		<xs:element name="plateminelevationmeo" type="xs:decimal" minOccurs="0"/>
		<xs:element name="satminelevationleo" type="xs:decimal" minOccurs="0"/>
		<xs:element name="satmaxelevationleo" type="xs:decimal" minOccurs="0"/>
		<xs:element name="satminelevationmeo" type="xs:decimal" minOccurs="0"/>
		<xs:element name="satmaxelevationmeo" type="xs:decimal" minOccurs="0"/>
		<xs:element name="plateminseparationangle" type="xs:decimal"/>
		<xs:element  name="location" type="dbfconfig:location"/>
		<xs:element  name="combiners" type="dbfconfig:combiners"/>
	</xs:all>
	<xs:attribute name="id" use="required" type="xs:string"/>
  </xs:complexType> 

    <xs:complexType name="location">
        <xs:all minOccurs="1">
            <xs:element name="latitude" type="xs:decimal"/>
            <xs:element name="longitude" type="xs:decimal"/>
            <xs:element name="altitude" type="xs:decimal"/>
        </xs:all>
    </xs:complexType>

  <xs:complexType name="combiners">
        <xs:sequence>
            <xs:element maxOccurs="unbounded" type="dbfconfig:combiner" name="combiner"/>
        </xs:sequence>
  </xs:complexType> 
 
  <xs:complexType name="combiner">
	<xs:all minOccurs="1">
		<xs:element name="constellation" type="xs:string"/>
		<xs:element name="ipaddress" type="xs:string"/>
	</xs:all>
	<xs:attribute name="id" use="required" type="xs:string"/>
  </xs:complexType> 
  
</xs:schema>