//
// EMSDBFPassScheduler.rc2 - resources Visual Studio's resource editor does not edit.
//
// The version resource lives here, not in EMSDBFPassScheduler.rc, so it can be
// built from Version.h: the resource editor would rewrite the macros below as
// literals the first time anyone saved the .rc. Change the version in
// Version.h, never here.
//

#ifndef APSTUDIO_INVOKED

#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    DBF_PASS_SCHEDULER_VERSION_MAJOR,DBF_PASS_SCHEDULER_VERSION_MINOR,DBF_PASS_SCHEDULER_VERSION_PATCH,0
 PRODUCTVERSION DBF_PASS_SCHEDULER_VERSION_MAJOR,DBF_PASS_SCHEDULER_VERSION_MINOR,DBF_PASS_SCHEDULER_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Honeywell Global Tracking"
            VALUE "FileDescription", "TSI DBF Pass Scheduler"
            VALUE "FileVersion", DBF_PASS_SCHEDULER_VERSION
            VALUE "InternalName", "TSIDBFPassScheduler.exe"
            VALUE "LegalCopyright", "Copyright (C) 2022"
            VALUE "OriginalFilename", "TSIDBFPassScheduler.exe"
            VALUE "ProductName", "TSIDBFPassScheduler"
            VALUE "ProductVersion", DBF_PASS_SCHEDULER_VERSION " (" BUILD_GIT_HASH ")"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // !APSTUDIO_INVOKED
